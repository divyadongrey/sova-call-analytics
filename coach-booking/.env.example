# ── Apps Script (replaces Google Cloud / Service Account) ──────────────────
# Deploy your apps-script/Code.gs as a Web App and paste the URL here
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Secret token — copy from the Apps Script execution log after running setupSheets()
APPS_SCRIPT_SECRET=paste-the-uuid-from-script-properties-here

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── Email confirmations (optional) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Coach Booking <your-email@gmail.com>"

# ── App config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Coach Booking Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOKING_TIMEZONE=Asia/Kolkata

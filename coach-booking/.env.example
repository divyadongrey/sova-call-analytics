# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Google Calendar (optional - uses same service account)
GOOGLE_CALENDAR_ENABLED=true

# NextAuth
NEXTAUTH_SECRET=generate-a-strong-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Email (SMTP for confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Coach Booking <your-email@gmail.com>"

# App config
NEXT_PUBLIC_APP_NAME="Coach Booking Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOKING_TIMEZONE=Asia/Kolkata
